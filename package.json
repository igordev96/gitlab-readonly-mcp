{
  "name": "gitlab-readonly-mcp",
  "version": "0.11.0",
  "description": "Read-only, git-backed MCP server for a self-managed GitLab",
  "keywords": [
    "ai-agents",
    "developer-tools",
    "git",
    "gitlab",
    "mcp",
    "model-context-protocol",
    "read-only"
  ],
  "homepage": "https://github.com/igordev96/gitlab-readonly-mcp#readme",
  "bugs": {
    "url": "https://github.com/igordev96/gitlab-readonly-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igordev96/gitlab-readonly-mcp.git"
  },
  "bin": {
    "gitlab-readonly-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:pack": "npm run build && node scripts/check-pack.mjs",
    "dev": "tsx src/index.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
